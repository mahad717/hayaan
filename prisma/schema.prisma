// E-commerce schema — uses Prisma SQLite locally, ready to swap to Supabase Postgres.
// See `src/lib/supabase/README.md` for the migration guide.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password   String   // bcrypt-hashed. When Supabase Auth is enabled, this column is unused.
  role      String   @default("customer") // "customer" | "admin"
  // Saved shipping profile — prefills checkout. All optional; Supabase mode
  // mirrors these columns on public.users (see supabase/schema.sql).
  phone     String?
  address   String?
  city      String?
  zip       String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart      Cart?
  orders    Order[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Float    // stored in major currency units (e.g. USD)
  compareAt   Float?   // original price for showing discounts
  currency    String   @default("USD")
  sku         String?
  stock       Int      @default(0)
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  images      String   // JSON array of image URLs
  tags        String?  // JSON array of tags
  featured    Boolean  @default(false)
  isActive    Boolean  @default(true)
  supplierUrl String?  @map("supplier_url") // dropshipping source listing (Task 65)
  supplierSku String?  @map("supplier_sku")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          String      @default("pending") // pending | paid | shipped | delivered | cancelled
  totalAmount     Float
  currency        String      @default("USD")
  shippingName    String
  shippingPhone   String?
  shippingAddress String
  shippingCity    String
  shippingZip     String
  shippingCountry String
  paymentMethod   String      @default("card")
  paymentRef      String?
  paymentStatus   String      @default("pending") // pending | paid | failed (real gateways like Sifalo Pay)
  // Accounting columns (Task 49). Discount/shipping/tax are what the customer
  // was charged; refund_amount accumulates admin-recorded refunds.
  discountAmount  Float       @default(0)
  shippingCost    Float       @default(0)
  taxAmount       Float       @default(0)
  refundAmount    Float       @default(0)
  refundedAt      DateTime?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  name       String  // snapshot of product name at time of order
  price      Float   // snapshot of price at time of order
  quantity   Int
  image      String? // snapshot of first image URL
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  content     String    @default("")
  coverImage  String?
  authorName  String    @default("Hayaan Team")
  status      String    @default("draft") // "draft" | "published"
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Accounting & reconciliation (Task 49).
//
// Deliberately SIDE-CAR tables keyed by plain ids (no Prisma relations) so the
// existing catalog/order models are untouched. In Supabase these tables are
// RLS-locked (no anon/authenticated policies) — only the server's service
// role can read them, so product cost never reaches customers through any
// public API (the public routes simply never select these tables).
// ---------------------------------------------------------------------------

// Confidential supplier cost, 1:1 with Product. Kept OUT of the Product model
// so every existing public product query stays cost-free by construction.
model ProductCost {
  productId String   @id
  unitCost  Float // >= 0, major currency units (matches Product.price)
  currency  String   @default("USD")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cost snapshot at the time of sale. One row per order item WITH a known
// cost; historical items without a row mean COGS unknown (reported as such —
// never guessed). Kept out of OrderItem because customers can SELECT their
// own order_items (RLS) and must never receive margin data.
model OrderItemCost {
  id          String   @id @default(cuid())
  orderItemId String   @unique
  productId   String?
  unitCost    Float // product cost at the moment the order was placed
  currency    String   @default("USD")
  createdAt   DateTime @default(now())

  @@index([productId])
}

// Payment records for reconciliation (gateway webhooks, manual entries, demo
// captures). (provider, transactionRef) unique → the same gateway reference
// can never be counted twice.
model PaymentRecord {
  id             String    @id @default(cuid())
  orderId        String
  provider       String // "sifalo" | "demo" | "manual" | ...
  method         String? // card | edahab | evc | cod | ...
  transactionRef String?
  amount         Float? // gateway-reported amount; null for failed attempts
  currency       String    @default("USD")
  status         String // pending | paid | failed
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  @@unique([provider, transactionRef])
  @@index([orderId])
  @@index([status])
}

// Internal double-entry-style ledger. Grouped by entryGroup: one financial
// event writes related rows (e.g. a SALE writes revenue +, cogs -,
// gross_profit +). Traceability layer only — report totals aggregate the
// order tables directly so the two can be cross-checked.
model LedgerEntry {
  id          String   @id @default(cuid())
  entryType   String // sale | refund | purchase | cancel | adjustment
  account     String // revenue | cogs | gross_profit | refunds | shipping | tax | inventory | cash | accounts_payable
  entryGroup  String?
  orderId     String?
  paymentId   String?
  purchaseId  String?
  productId   String?
  amount      Float // signed
  currency    String   @default("USD")
  description String?
  actor       String?
  createdAt   DateTime @default(now())

  @@index([entryType])
  @@index([entryGroup])
  @@index([orderId])
  @@index([createdAt])
}

// Supplier purchases / restocks (section 9). stockApplied records whether
// product.stock was incremented, keeping the auditable inventory trail honest.
model Purchase {
  id            String   @id @default(cuid())
  supplier      String
  productId     String?
  quantity      Int // > 0
  unitCost      Float // >= 0
  totalCost     Float
  purchaseDate  DateTime @default(now())
  reference     String?
  paymentStatus String   @default("unpaid") // paid | unpaid
  stockApplied  Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([purchaseDate])
}

// Auditable Inventory → Sale → COGS chain.
model InventoryMovement {
  id            String   @id @default(cuid())
  productId     String
  orderId       String?
  purchaseId    String?
  movementType  String // sale | purchase | refund_restock | adjustment
  quantityDelta Int // negative when stock leaves
  unitCost      Float? // cost snapshot tied to this movement
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

// Who changed what, old → new, for sensitive financial fields.
model AccountingAudit {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  entity     String // product | order | payment | purchase | reconciliation | inventory
  entityId   String?
  field      String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
}

// Lead capture (Task 57) — newsletter signups + bulk-quote requests.
// Supabase table: leads (RLS deny-all; API routes use the service role).
model Lead {
  id        String   @id @default(cuid())
  type      String   @default("newsletter") // newsletter | quote
  name      String?
  email     String?
  phone     String?
  business  String?
  message   String?
  source    String   @default("site") // popup | footer | quote-page
  status    String   @default("new") // new | contacted | won | lost
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("leads")
}
